# Replace this with the immutable digest shown by the GitHub image workflow.
APP_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/breakroom-pool@sha256:REPLACE_ME
APP_VERSION=development
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
DATA_ROOT=/srv/breakroom
PASSPORT_MASTER_KEY_PATH=/etc/breakroom/passport-master-key
