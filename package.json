{
  "name": "breakroom-pool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm run dev -w @breakroom/server\" \"npm run dev -w @breakroom/client\"",
    "build": "npm run build -w @breakroom/game-core && npm run build -w @breakroom/client && npm run build -w @breakroom/server",
    "start": "npm run start -w @breakroom/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ops": "bash ops/oracle/test/backup.test.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
