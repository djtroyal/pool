#!/usr/bin/env bash
set -Eeuo pipefail

file=
name=
while [[ $# -gt 0 ]]; do
  case $1 in
    --file) file=$2; shift 2 ;;
    --name) name=$2; shift 2 ;;
    *) shift ;;
  esac
done
[[ -n ${file} && -n ${name} && -n ${FAKE_OCI_UPLOADS:-} ]]
install -d "${FAKE_OCI_UPLOADS}"
cp "${file}" "${FAKE_OCI_UPLOADS}/$(basename "${name}")"
