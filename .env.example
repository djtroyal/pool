PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
# Permit a changing HTTPS *.trycloudflare.com origin. Keep false unless the
# server is reachable only through a Cloudflare Quick Tunnel.
ALLOW_TRYCLOUDFLARE_ORIGIN=false
# Trust CF-Connecting-IP only when the application port is not publicly exposed.
TRUST_CLOUDFLARE_IP=false
# Defaults to true under NODE_ENV=production and false during development/tests.
RATE_LIMITS_ENABLED=false
VITE_SERVER_URL=
DATA_DIR=./data
APP_VERSION=development
# Prefer a root-controlled file in production. PASSPORT_MASTER_KEY remains a
# supported fallback for existing installations.
# PASSPORT_MASTER_KEY_FILE=/run/secrets/passport_master_key
# DATABASE_PATH may be used instead of DATA_DIR for an explicit SQLite file.
